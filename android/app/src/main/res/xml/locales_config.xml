<?xml version="1.0" encoding="utf-8"?>
<!-- Lets Android offer a per-app language and keeps the native block screen and
     notification on the same language the in-app toggle picks. -->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="en" />
    <locale android:name="uz" />
</locale-config>
